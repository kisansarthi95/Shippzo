{threshold_days}` : \"\")).then(r => r.data),\n    /** Phase-12: Bulk Pending → Processing flip (warehouse \"I'm starting\n     *  to pack this batch\" action). Skips rows already past Pending. */\n    bulkMarkProcessing: shipment_ids => api.post(\"/shipments/bulk-mark-processing\", {\n      shipment_ids\n    }).then(r => r.data),\n    /** Phase-12: Dispatch Confirmation (post-Shipped notification) */\n    dispatchConfList: () => api.get(\"/shipments/dispatch-confirmation\").then(r => r.data),\n    dispatchConfMarkSent: shipment_ids => api.post(\"/shipments/dispatch-confirmation/mark-sent\", {\n      shipment_ids\n    }).then(r => r.data),\n    dispatchConfReset: shipment_ids => api.post(\"/shipments/dispatch-confirmation/reset\", {\n      shipment_ids\n    }).then(r => r.data),\n    /** Phase-12: Courier Rules (per-courier delivery_eta_days) */\n    meCourierRules: () => api.get(\"/me/courier-rules\").then(r => r.data),\n    meSaveCourierRules: rules => api.put(\"/me/courier-rules\", {\n      rules\n    }).then(r => r.data),\n    adminCourierRules: () => api.get(\"/admin/courier-rules\").then(r => r.data),\n    adminSaveCourierRules: rules => api.put(\"/admin/courier-rules\", {\n      rules\n    }).then(r => r.data),\n    /** Phase-12: WhatsApp Templates (4 types × 3 langs) */\n    meWhatsAppTemplates: () => api.get(\"/me/whatsapp-templates\").then(r => r.data),\n    meSaveWhatsAppTemplates: (templates, default_language, business_links, contact) => api.put(\"/me/whatsapp-templates\", {\n      templates,\n      default_language,\n      business_links,\n      shop_phone: contact?.shop_phone,\n      helpline: contact?.helpline\n    }).then(r => r.data),\n    adminWhatsAppTemplates: () => api.get(\"/admin/whatsapp-templates\").then(r => r.data),\n    adminSaveWhatsAppTemplates: templates => api.put(\"/admin/whatsapp-templates\", {\n      templates\n    }).then(r => r.data),\n    resolveTemplate: (ttype, lang) => api.get(`/me/resolve-template?ttype=${ttype}` + (lang ? `