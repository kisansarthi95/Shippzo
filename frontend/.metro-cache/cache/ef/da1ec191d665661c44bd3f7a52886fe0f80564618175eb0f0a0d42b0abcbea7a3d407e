...params\n      }\n    }).then(r => r.data),\n    meReconciliation: (params = {}) => api.get(\"/me/reports/reconciliation\", {\n      params: {\n        range: params.range || \"this_month\",\n        ...params\n      }\n    }).then(r => r.data),\n    /**\n     * Lookup an existing shipment by tracking_id. Returns null when no\n     * match (HTTP 404) instead of throwing, so callers don't have to\n     * try/catch — and React Native's \"Uncaught (in promise) AxiosError\n     * 404\" dev warning never fires for the expected \"tracking ID is new\"\n     * code path.\n     */\n    getShipmentByTracking: tracking_id => api.get(`/shipments/by-tracking/${encodeURIComponent(tracking_id)}`).then(r => r.data).catch(err => {\n      if (err?.response?.status === 404) return null;\n      throw err;\n    }),\n    bulkFetch: ids => api.post(`/shipments/bulk-fetch`, {\n      ids\n    }).then(r => r.data),\n    getShipment: id => api.get(`/shipments/${id}`).then(r => r.data),\n    createShipment: data => api.post(\"/shipments\", data).then(r => r.data),\n    updateShipment: (id, data) => api.put(`/shipments/${id}`, data).then(r => r.data),\n    deleteShipment: id => api.delete(`/shipments/${id}`).then(r => r.data),\n    csvUrl: () => `${BASE}/api/shipments/export/csv`,\n    // Smart Paste & Pending Orders\n    smartPasteParse: text => api.post(\"/smart-paste/parse\", {\n      text\n    }).then(r => r.data),\n    smartPasteCheckDuplicate: text => api.post(\"/smart-paste/check-duplicate\", {\n      text\n    }).then(r => r.data),\n    smartPasteCreate: (text, skipLlm = false, customValues) => api.post(\"/smart-paste\", {\n      text,\n      skip_llm: skipLlm,\n      custom_values: customValues || undefined\n    }, {\n      // Phase-12 fix: this endpoint writes to Google Sheets BEFORE\n      // saving to Mongo (atomic guarantee). On a flaky cellular\n      // connection the Sheets API can take 15-25s on its own — the\n      // default 25 s axios timeout was firing right at the edge and\n      // surfacing as \"Network Error\" even when the backend was\n      // about to succeed. 60 s comfortably covers a slow round-trip.\n      timeout: 60000\n    }).then(r => r.data),\n    // Phase-C: Pull every Master-Sheet row tagged with the caller's\n    // user_id into the caller's own personal sheet. `overwrite=true`\n    // (default) clears the user's tab data rows first to reflect any\n    // admin edits. `false` appends only new rows (dedup by master_order_id\n    // / composite key for legacy rows).\n    syncFromMaster: (overwrite = true) => api.post(\"/sheets/sync-from-master\", {\n      overwrite\n    }).then(r => r.data),\n    // Phase-7e: Live preview of the next Master Order ID for the New\n    // Shipment form. Does NOT consume the counter — actual ID is allocated\n    // at save time. Frontend may pass the previewed value back via\n    // `master_order_id` in POST /shipments to lock it in.\n    peekMasterOrderId: () => api.get(\"/orders/peek-master-id\").then(r => r.data),\n    // Phase-7f: Read / write the global Master Order ID counter.\n    // Used in Settings to migrate from a legacy numbering system —\n    // eg user has shipped 2200 parcels and wants the next master ID\n    // to start from `02201`. setMasterIdCounter forces seq=2200 so the\n    // next allocation produces `<YYMMDD>02201`.\n    getMasterIdCounter: () => api.get(\"/orders/master-id-counter\").then(r => r.data),\n    setMasterIdCounter: (seq, force = false) => api.post(\"/orders/master-id-counter\", {\n      seq,\n      force\n    }).then(r => r.data),\n    // Conversational Smart Paste (chat UI).\n    smartPasteChat: (fields, reply) => api.post(\"/smart-paste/chat\", {\n      fields,\n      reply\n    }).then(r => r.data),\n    // Phase-15: City → State + Pincode candidate lookup. Powers the\n    // Smart Paste Summary Card auto-fill / \"Confirm pincode\" UX.\n    // Free India Post API behind a Mongo cache, so repeat lookups\n    // for the same city are instant and don't hit the network.\n    lookupByCity: q => api.get(`/lookup/by-city`, {\n      params: {\n        q\n      }\n    }).then(r => r.data),\n    // Forward lookup: pincode → state/district. Used by the inline\n    // \"Confirm pincode\" button to verify a pasted pincode.\n    lookupByPincode: pincode => api.get(`/lookup/by-pincode/${encodeURIComponent(pincode)}`).then(r => r.data),\n    // ── Phase-16: Save Contact (per-user settings + VCF builder) ───\n    getContactSettings: () => api.get(\"/me/contact-settings\").then(r => r.data),\n    putContactSettings: patch => api.put(\"/me/contact-settings\", patch).then(r => r.data),\n    buildOneContact: args => api.post(\"/contacts/build-one\", args).then(r => r.data),\n    buildBulkVcf: (shipment_ids, override_category = \"\") => api.post(\"/contacts/build-vcf\", {\n      shipment_ids,\n      override_category\n    }).then(r => r.data),\n    // Phase-16.1 — Duplicate save detection. checkContactSaved returns\n    // {saved:false} for first-time saves; otherwise also includes the\n    // previously-saved name + saved_at timestamp so the UI can show\n    // a friendly \"Already saved\" prompt with Cancel / Save anyway.\n    checkContactSaved: phone => api.get(\"/contacts/saved-check\", {\n      params: {\n        phone\n      }\n    }).then(r => r.data),\n    markContactSaved: args => api.post(\"/contacts/mark-saved\", args).then(r => r.data),\n    // Photo OCR — Gemini Vision. Uses an extended 90 s timeout because\n    // vision calls + the address-recovery follow-up can take up to ~45 s\n    // on a slow mobile connection. The default 25 s axios timeout would\n    // surface as \"Network Error\" on the client even though the backend\n    // is still happily processing.\n    smartPastePhoto: (image_base64, mime = \"image/jpeg\") => api.post(\"/smart-paste/photo\", {\n      image_base64,\n      mime\n    }, {\n      timeout: 90000\n    }).then(r => r.data),\n    // Customer memory — look up past customer by phone for auto-suggest.\n    lookupCustomerByPhone: phone => api.get(`/customers/by-phone/${encodeURIComponent(phone)}`).then(r => r.data),\n    // Phase-4b+ Smart Paste AI helpers\n    smartPasteDefaultPrompt: () => api.get(\"/smart-paste/default-prompt\").then(r => r.data),\n    listPendingOrders: params => api.get(\"/orders/pending\", {\n      params\n    }).then(r => r.data),\n    getPendingOrder: id => api.get(`/orders/pending/${id}`).then(r => r.data),\n    updatePendingOrder: (id, data) => api.put(`/orders/pending/${id}`, data).then(r => r.data),\n    deletePendingOrder: id => api.delete(`/orders/pending/${id}`).then(r => r.data),\n    shipPendingOrder: (id, courier_id, overrides) => api.post(`/orders/pending/${id}/ship`, {\n      courier_id,\n      overrides\n    }).then(r => r.data),\n    pendingOrdersCount: () => api.get(\"/orders/pending-count\").then(r => r.data),\n    // Phase-21 — Flip the `viewed` flag server-side so the green ✨ NEW\n    // badge clears on every device the next time the Orders tab loads.\n    // Fire-and-forget on the client — UI optimistically updates first.\n    markPendingOrderViewed: id => api.post(`/orders/pending/${id}/mark-viewed`).then(r => r.data),\n    // ─────── Phase-21 — Support Center / Tickets ───────\n    /** Create a new support ticket. The first message is taken from\n     *  `description` and stored inline on the ticket so the detail\n     *  screen renders without a second fetch. */\n    supportCreateTicket: payload => api.post(`/support/tickets`, {\n      title: payload.title,\n      description: payload.description,\n      category: payload.category || \"general\"\n    }).then(r => r.data),\n    /** List the current user's tickets (newest-first). Pass `status`\n     *  to narrow to open / in_progress / resolved / closed. */\n    supportListMyTickets: status => api.get(`/support/tickets`, {\n      params: status ? {\n        status\n      } : undefined\n    }).then(r => r.data),\n    /** Full ticket including the inline `messages[]` thread. */\n    supportGetTicket: id => api.get(`/support/tickets/${id}`).then(r => r.data),\n    /** Append a reply. The server flips ticket status to `in_progress`\n     *  when an admin replies to an `open` ticket. */\n    supportReply: (id, body) => api.post(`/support/tickets/${id}/reply`, {\n      body\n    }).then(r => r.data),\n    /** User-side close — marks the ticket resolved + closed. */\n    supportCloseTicket: id => api.post(`/support/tickets/${id}/close`).then(r => r.data),\n    // ─────── Phase F1 — CSV / XLSX bulk import ───────\n    /** Parse an uploaded CSV/XLSX without writing to DB. Returns columns,\n     *  first 10 rows, total row count, schema fields, and an\n     *  auto-suggested column→field mapping (saved-default + naive header\n     *  match). */\n    fileImportPreview: async (uri, name, mime) => {\n      const fd = new FormData();\n      // RN FormData accepts {uri, name, type} ducktyped as Blob.\n      fd.append(\"file\", {\n        uri,\n        name,\n        type: mime\n      });\n      return api.post(\"/orders/import/preview\", fd, {\n        headers: {\n          \"Content-Type\": \"multipart/form-data\"\n        }\n      }).then(r => r.data);\n    },\n    /** Commit an upload with the user-confirmed mapping. Optionally\n     *  saves the mapping as default for next time. */\n    fileImportCommit: async (uri, name, mime, mapping, save_default = false) => {\n      const fd = new FormData();\n      fd.append(\"file\", {\n        uri,\n        name,\n        type: mime\n      });\n      fd.append(\"mapping\", JSON.stringify(mapping));\n      fd.append(\"save_default\", save_default ? \"true\" : \"false\");\n      return api.post(\"/orders/import/commit\", fd, {\n        headers: {\n          \"Content-Type\": \"multipart/form-data\"\n        }\n      }).then(r => r.data);\n    },\n    getFileImportMapping: () => api.get(\"/me/file-import-mapping\").then(r => r.data),\n    putFileImportMapping: mapping => api.put(\"/me/file-import-mapping\", {\n      mapping\n    }).then(r => r.data),\n    // --- Feature 1: Write headers to user sheet ---\n    syncSheetHeaders: (dry_run = false) => api.post(\"/sheets/sync-headers\", {\n      dry_run\n    }).then(r => r.data),\n    // --- Feature 2: Per-user custom fields ---\n    listMyCustomFields: () => api.get(\"/me/custom-fields\").then(r => r.data),\n    createMyCustomField: data => api.post(\"/me/custom-fields\", data).then(r => r.data),\n    updateMyCustomField: (id, data) => api.put(`/me/custom-fields/${id}`, data).then(r => r.data),\n    deleteMyCustomField: id => api.delete(`/me/custom-fields/${id}`).then(r => r.data),\n    // --- Phase F2.2: Webhook ingest config ---\n    getWebhookConfig: () => api.get(\"/me/webhook-config\").then(r => r.data),\n    rotateWebhookSecret: name => api.post(\"/me/webhook-config/rotate\", name ? {\n      name\n    } : undefined).then(r => r.data),\n    putWebhookName: name => api.put(\"/me/webhook-config/name\", {\n      name\n    }).then(r => r.data),\n    // ─── Phase G: Onboarding business-category ──────────────────────\n    listBusinessCategories: () => api.get(\"/auth/business-categories\").then(r => r.data),\n    setBusinessCategory: category => api.post(\"/auth/business-category\", {\n      category\n    }).then(r => r.data),\n    putWebhookMapping: mapping => api.put(\"/me/webhook-config\", {\n      mapping\n    }).then(r => r.data),\n    // ─── Phase F3: Multi-webhook (named, event-typed, unlimited) ───────\n    listWebhookEventTypes: () => api.get(\"/me/webhooks/event-types\").then(r => r.data),\n    listWebhooks: () => api.get(\"/me/webhooks\").then(r => r.data),\n    createWebhook: body => api.post(\"/me/webhooks\", body).then(r => r.data),\n    getWebhook: id => api.get(`/me/webhooks/${id}`).then(r => r.data),\n    updateWebhook: (id, body) => api.put(`/me/webhooks/${id}`, body).then(r => r.data),\n    rotateWebhook: id => api.post(`/me/webhooks/${id}/rotate`).then(r => r.data),\n    deleteWebhook: id => api.delete(`/me/webhooks/${id}`).then(r => r.data),\n    previewWebhookV2: (id, payload) => api.post(`/me/webhooks/${id}/preview`, payload).then(r => r.data),\n    previewWebhookPayload: payload => api.post(\"/me/webhook-config/preview\", payload).then(r => r.data),\n    // ── Phase F3.3 — Abandoned Carts ──────────────────────────────────\n    abandonedCartStats: () => api.get(\"/me/abandoned-carts/stats\").then(r => r.data),\n    listAbandonedCarts: params => api.get(\"/me/abandoned-carts\", {\n      params\n    }).then(r => r.data),\n    getAbandonedCart: id => api.get(`/me/abandoned-carts/${id}`).then(r => r.data),\n    recoverAbandonedCart: (id, opts) => api.post(`/me/abandoned-carts/${id}/recover`, {\n      create_shipment: !!opts?.create_shipment\n    }).then(r => r.data),\n    // ─── Phase F3.9.8 — Short-link service ─────────────────────────\n    // Compacts long platform recovery URLs into a tidy /api/s/<code>\n    // alias. Used by the WhatsApp recovery message composer so the\n    // customer message looks intentional instead of dumping a 100-char\n    // raw URL. Idempotent — calling twice for the same target_url\n    // returns the same short code.\n    shortenUrl: (target_url, cart_id) => api.post(\"/short-links\", {\n      target_url,\n      cart_id: cart_id || null\n    }).then(r => r.data),\n    dismissAbandonedCart: id => api.post(`/me/abandoned-carts/${id}/dismiss`).then(r => r.data),\n    deleteAbandonedCart: id => api.delete(`/me/abandoned-carts/${id}`).then(r => r.data),\n    // ── Phase F3.3 — Customers ────────────────────────────────────────\n    customerStats: () => api.get(\"/me/customers/stats\").then(r => r.data),\n    listCustomers: params => api.get(\"/me/customers\", {\n      params\n    }).then(r => r.data),\n    getCustomer: id => api.get(`/me/customers/${id}`).then(r => r.data),\n    deleteCustomer: id => api.delete(`/me/customers/${id}`).then(r => r.data)\n  };\n  // Phase F2.3 (2026-05-09) — Sheet column-mapping fields aligned wi