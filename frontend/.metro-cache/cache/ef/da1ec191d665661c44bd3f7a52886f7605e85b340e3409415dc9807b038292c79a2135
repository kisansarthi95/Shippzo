vider's default was cleared).\n   */\n  api.interceptors.request.use(async config => {\n    try {\n      if (!config.headers?.Authorization && !config.headers?.authorization) {\n        const token = await AsyncStorage.default.getItem(\"@auth_token\");\n        if (token) {\n          config.headers = config.headers ?? {};\n          config.headers.Authorization = `Bearer ${token}`;\n        }\n      }\n    } catch {\n      /* storage unavailable - continue without */\n    }\n    return config;\n  });\n\n  /**\n   * Response interceptor: on 401 (expired/invalid token) clear credentials\n   * so AuthGate can redirect to /login. We import auth dynamically to avoid\n   * a circular module-load between auth.tsx and api.ts.\n   */\n  let _onUnauthorized = null;\n  function registerUnauthorizedHandler(fn) {\n    _onUnauthorized = fn;\n  }\n  api.interceptors.response.use(r => r, async err => {\n    const status = err?.response?.status;\n    const url = err?.config?.url || \"\";\n    // Don't auto-logout on the login/signup endpoints themselves — their\n    // 401 means \"wrong credentials\", which the form handles locally.\n    const isAuthEndpoint = url.includes(\"/auth/login\") || url.includes(\"/auth/signup\");\n    if (status === 401 && !isAuthEndpoint) {\n      try {\n        await AsyncStorage.default.multiRemove([\"@auth_token\", \"@auth_user\"]);\n        delete api.defaults.headers.common[\"Authorization\"];\n      } catch {\n        /* ignore */\n      }\n      _onUnauthorized?.();\n    }\n    return Promise.reject(err);\n  });\n\n  // Phase-3a Plans & Usage ----------------------------------------------------\n\n  // 2026-04-30 — Coupon system types\n\n  // Phase-4a Credit Wallet ----------------------------------------------------\n\n  const Api = {\n    listCouriers: () => api.get(\"/couriers\").then(r => r.data),\n    getCourier: id => api.get(`/couriers/${id}`).then(r => r.data),\n    createCourier: data => api.post(\"/couriers\", data).then(r => r.data),\n    getCourierLimits: () => api.get(\"/couriers/limits\").then(r => r.data),\n    updateCourier: (id, data) => api.put(`/couriers/${id}`, data).then(r => r.data),\n    deleteCourier: id => api.delete(`/couriers/${id}`).then(r => r.data),\n    peekNextTracking: id => api.get(`/couriers/${id}/next-tracking`).then(r => r.data),\n    consumeTracking: id => api.post(`/couriers/${id}/consume-tracking`).then(r => r.data),\n    // --- Phase-3a Plans & Usage ---\n    listPlans: () => api.get(\"/plans\").then(r => r.data),\n    myUsage: () => api.get(\"/me/usage\").then(r => r.data),\n    // Phase-5c Anchor pricing & countdown (admin tunable)\n    getPlansPricing: () => api.get(\"/plans-pricing\").then(r => r.data),\n    upgradePlan: plan => api.post(\"/plans/upgrade\", {\n      plan\n    }).then(r => r.data),\n    // --- Phase-4a Wallet ---\n    getWallet: () => api.get(\"/wallet\").then(r => r.data),\n    getWalletHistory: (limit = 100) => api.get(\"/wallet/history\", {\n      params: {\n        limit\n      }\n    }).then(r => r.data),\n    purchaseCredits: amount_inr => api.post(\"/wallet/purchase\", {\n      amount_inr\n    }).then(r => r.data),\n    // Phase-4c Razorpay live payments\n    rzpCreateOrder: amount_inr => api.post(\"/wallet/razorpay/create-order\", {\n      amount_inr\n    }).then(r => r.data),\n    rzpVerify: (razorpay_order_id, razorpay_payment_id, razorpay_signature) => api.post(\"/wallet/razorpay/verify\", {\n      razorpay_order_id,\n      razorpay_payment_id,\n      razorpay_signature\n    }).then(r => r.data),\n    // Phase-4d Razorpay Plan Subscriptions\n    rzpCreatePlanOrder: (plan_key, billing_cycle, coupon_code) => api.post(\"/plans/razorpay/create-order\", {\n      plan_key,\n      billing_cycle,\n      coupon_code: coupon_code || undefined\n    }).then(r => r.data),\n    rzpVerifyPlan: (razorpay_order_id, razorpay_payment_id, razorpay_signature) => api.post(\"/plans/razorpay/verify\", {\n      razorpay_order_id,\n      razorpay_payment_id,\n      razorpay_signature\n    }).then(r => r.data),\n    // ── Coupons (2026-04-30) ──────────────────────────────────────\n    // Admin CRUD endpoints (gated server-side by is_admin):\n    adminListCoupons: () => api.get(\"/admin/coupons\").then(r => r.data.coupons),\n    adminCreateCoupon: payload => api.post(\"/admin/coupons\", payload).then(r => r.data.coupon),\n    adminUpdateCoupon: (id, payload) => api.put(`/admin/coupons/${id}`, payload).then(r => r.data.coupon),\n    adminDeleteCoupon: id => api.delete(`/admin/coupons/${id}`).then(r => r.data),\n    adminCouponAnalytics: () => api.get(\"/admin/coupons/analytics\").then(r => r.data),\n    // User-facing validate. Never writes — only the payment-verify path\n    // bumps `used_count` after a successful Razorpay charge.\n    validateCoupon: (code, plan_key, billing_cycle) => api.post(\"/coupons/validate\", {\n      code,\n      plan_key,\n      billing_cycle\n    }).then(r => r.data),\n    // Phase-4d notification prefs + subscription mgmt\n    getNotificationPrefs: () => api.get(\"/me/notification-prefs\").then(r => r.data),\n    updateNotificationPrefs: prefs => api.put(\"/me/notification-prefs\", prefs).then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase H — User personal-sheet auto-sync\n    // ───────────────────────────────────────────────────────────────────\n    meSheetSyncStatus: () => api.get(\"/me/sheet-sync/status\").then(r => r.data),\n    meSheetSyncToggles: payload => api.put(\"/me/sheet-sync/toggles\", payload).then(r => r.data),\n    meSheetSyncRunNow: () => api.post(\"/me/sheet-sync/run-now\").then(r => r.data),\n    meSheetSyncShipment: shipment_id => api.post(`/me/sheet-sync/shipment/${encodeURIComponent(shipment_id)}`).then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase G6 — Expo push token registry & test\n    // ───────────────────────────────────────────────────────────────────\n    registerPushToken: payload => api.post(\"/me/push-token\", payload).then(r => r.data),\n    removePushToken: token => api.delete(\"/me/push-token\", {\n      params: {\n        token\n      }\n    }).then(r => r.data),\n    testPushToSelf: () => api.post(\"/me/push-token/test\").then(r => r.data),\n    listMyPushTokens: () => api.get(\"/me/push-tokens\").then(r => r.data),\n    cancelSubscription: () => api.post(\"/me/cancel-subscription\").then(r => r.data),\n    quoteLabel: (address = \"\") => api.get(\"/wallet/quote\", {\n      params: {\n        address\n      }\n    }).then(r => r.data),\n    getSettings: () => api.get(\"/settings\").then(r => r.data),\n    updateSettings: data => api.put(\"/settings\", data).then(r => r.data),\n    sheetsPreview: url => api.post(\"/sheets/preview\", {\n      url\n    }).then(r => r.data),\n    sheetsServiceAccount: () => api.get(\"/sheets/service-account\").then(r => r.data),\n    sheetsOrders: () => api.get(\"/sheets/orders\").then(r => r.data),\n    listShipments: params => api.get(\"/shipments\", {\n      params\n    }).then(r => r.data),\n    getStats: () => api.get(\"/shipments/stats\").then(r => r.data),\n    /**\n     * Phase-9: Warehouse-optimised \"Scan to Dispatch\" endpoint. Flips\n     * a shipment from Pending → Dispatch atomically (no race), echoes\n     * the outcome bucket the scanner UI needs:\n     *   \"moved\"   — was Pending, now Dispatch (cream success toast)\n     *   \"already\" — was already Dispatch (warn banner)\n     *   \"failed\"  — not found OR wrong status (red badge)\n     */\n    scanDispatch: tracking_id => api.post(\"/shipments/scan-dispatch\", {\n      tracking_id\n    }).then(r => r.data),\n    /**\n     * Phase-10: Sibling to scanDispatch — flips Dispatch → Shipped\n     * atomically. Same outcome contract so the scanner UI shares code.\n     */\n    scanShip: tracking_id => api.post(\"/shipments/scan-ship\", {\n      tracking_id\n    }).then(r => r.data),\n    /** Phase-11: Delivery Confirmation (Shipped → Delivered via WhatsApp) */\n    deliveryConfList: (threshold_days = 5) => api.get(`/shipments/delivery-confirmation?threshold_days=${threshold_days}`).then(r => r.data),\n    deliveryConfMarkSent: shipment_ids => api.post(\"/shipments/delivery-confirmation/mark-sent\", {\n      shipment_ids\n    }).then(r => r.data),\n    deliveryConfMarkDelivered: shipment_ids => api.post(\"/shipments/delivery-confirmation/mark-delivered\", {\n      shipment_ids\n    }).then(r => r.data),\n    /**\n     * Phase-12: V2 Delivery Confirmation list — uses per-courier ETA\n     * rules instead of a single global threshold. Pass `threshold_days`\n     * to override (legacy behaviour). Each shipment carries its own\n     * `courier_eta_days` so the UI can show \"5 days / 8 days\" badges.\n     */\n    deliveryConfListV2: threshold_days => api.get(\"/shipments/delivery-confirmation-v2\" + (threshold_days != null ? `?threshold_days=${threshold_days}` : \"\")).then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase F2/F3 — Generic Bulk Message endpoints (5 stages share one\n    // pair). Replaces the per-type dispatch / delivery list calls.\n    // ───────────────────────────────────────────────────────────────────\n    bulkMsgEligible: (ttype, threshold_days) => api.get(\"/me/bulk-message/eligible\", {\n      params: {\n        ttype,\n        ...(threshold_days != null ? {\n          threshold_days\n        } : {})\n      }\n    }).then(r => r.data),\n    bulkMsgMarkSent: (ttype, shipment_ids) => api.post(\"/me/bulk-message/mark-sent\", {\n      ttype,\n      shipment_ids\n    }).then(r => r.data),\n    bulkMsgReset: (ttype, shipment_ids) => api.post(\"/me/bulk-message/reset\", {\n      ttype,\n      shipment_ids\n    }).then(r => r.data),\n    bulkMsgDashboardCounts: () => api.get(\"/me/bulk-message/dashboard-counts\").then(r => r.data),\n    /** Phase-12: Bulk Pending → Processing flip (warehouse \"I'm starting\n     *  to pack this batch\" action). Skips rows already past Pending. */\n    bulkMarkProcessing: shipment_ids => api.post(\"/shipments/bulk-mark-processing\", {\n      shipment_ids\n    }).then(r => r.data),\n    /** Phase-12: Dispatch Confirmation (post-Shipped notification) */\n    dispatchConfList: () => api.get(\"/shipments/dispatch-confirmation\").then(r => r.data),\n    dispatchConfMarkSent: shipment_ids => api.post(\"/shipments/dispatch-confirmation/mark-sent\", {\n      shipment_ids\n    }).then(r => r.data),\n    dispatchConfReset: shipment_ids => api.post(\"/shipments/dispatch-confirmation/reset\", {\n      shipment_ids\n    }).then(r => r.data),\n    /** Phase-12: Courier Rules (per-courier delivery_eta_days) */\n    meCourierRules: () => api.get(\"/me/courier-rules\").then(r => r.data),\n    meSaveCourierRules: rules => api.put(\"/me/courier-rules\", {\n      rules\n    }).then(r => r.data),\n    adminCourierRules: () => api.get(\"/admin/courier-rules\").then(r => r.data),\n    adminSaveCourierRules: rules => api.put(\"/admin/courier-rules\", {\n      rules\n    }).then(r => r.data),\n    /** Phase-12: WhatsApp Templates (4 types × 3 langs) */\n    meWhatsAppTemplates: () => api.get(\"/me/whatsapp-templates\").then(r => r.data),\n    meSaveWhatsAppTemplates: (templates, default_language, business_links, contact) => api.put(\"/me/whatsapp-templates\", {\n      templates,\n      default_language,\n      business_links,\n      shop_phone: contact?.shop_phone,\n      helpline: contact?.helpline\n    }).then(r => r.data),\n    adminWhatsAppTemplates: () => api.get(\"/admin/whatsapp-templates\").then(r => r.data),\n    adminSaveWhatsAppTemplates: templates => api.put(\"/admin/whatsapp-templates\", {\n      templates\n    }).then(r => r.data),\n    resolveTemplate: (ttype, lang) => api.get(`/me/resolve-template?ttype=${ttype}` + (lang ? `&lang=${lang}` : \"\")).then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase-15: AI WhatsApp template generator + daily-limit anti-block\n    // ───────────────────────────────────────────────────────────────────\n    meWhatsAppPricing: () => api.get(\"/me/whatsapp-pricing\").then(r => r.data),\n    meWhatsAppDailyStatus: () => api.get(\"/me/whatsapp/daily-status\").then(r => r.data),\n    meWhatsAppDailyIncrement: (force = false) => api.post(\"/me/whatsapp/daily-increment\", {\n      force\n    }).then(r => r.data),\n    meGenerateTemplateVariants: (template_type, tone_description, quick_chip) => api.post(\"/me/whatsapp-templates/generate-variants\", {\n      template_type,\n      tone_description,\n      quick_chip\n    }).then(r => r.data),\n    meSaveTemplateVariants: (template_type, variants) => api.post(\"/me/whatsapp-templates/save-variants\", {\n      template_type,\n      variants\n    }).then(r => r.data),\n    meGetTemplateVariants: () => api.get(\"/me/whatsapp-template-variants\").then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase-G1/G2: Stage Rules — unified SLA + alert + template config\n    // ───────────────────────────────────────────────────────────────────\n    adminGetStageRules: () => api.get(\"/admin/stage-rules\").then(r => r.data),\n    adminPutStageRules: payload => api.put(\"/admin/stage-rules\", payload).then(r => r.data),\n    meGetStageRules: () => api.get(\"/me/stage-rules\").then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase-G3: SLA Engine — alerts, scan trigger, summary\n    // ───────────────────────────────────────────────────────────────────\n    adminSlaRunNow: () => api.post(\"/admin/sla/run-now\").then(r => r.data),\n    adminSlaAlerts: (params = {}) => api.get(\"/admin/sla/alerts\", {\n      params\n    }).then(r => r.data),\n    adminSlaSummary: () => api.get(\"/admin/sla/summary\").then(r => r.data),\n    adminSlaDismiss: alertId => api.post(`/admin/sla/alerts/${encodeURIComponent(alertId)}/dismiss`).then(r => r.data),\n    adminSlaDismissBulk: payload => api.post(\"/admin/sla/alerts/dismiss-bulk\", payload).then(r => r.data),\n    meSlaAlerts: (params = {}) => api.get(\"/me/sla/alerts\", {\n      params\n    }).then(r => r.data),\n    /**\n     * Lookup an existing shipment by tracking_id. Returns null when no\n     * match (HTTP 404) instead of throwing, so callers don't have to\n     * try/catch — and React Native's \"Uncaught (in promise) AxiosError\n     * 404\" dev warning never fires for the expected \"tracking ID is new\"\n     * code path.\n     */\n    getShipmentByTracking: tracking_id => api.get(`/shipments/by-tracking/${encodeURIComponent(tracking_id)}`).then(r => r.data).catch(err => {\n      if (err?.response?.status === 404) return null;\n      throw err;\n    }),\n    bulkFetch: ids => api.post(`/shipments/bulk-fetch`, {\n      ids\n    }).then(r => r.data),\n    getShipment: id => api.get(`/shipments/${id}`).then(r => r.data),\n    createShipment: data => api.post(\"/shipments\", data).then(r => r.data),\n    updateShipment: (id, data) => api.put(`/shipments/${id}`, data).then(r => r.data),\n    deleteShipment: id => api.delete(`/shipments/${id}`).then(r => r.data),\n    csvUrl: () => `${BASE}/api/shipments/export/csv`,\n    // Smart Paste & Pending Orders\n    smartPasteParse: text => api.post(\"/smart-paste/parse\", {\n      text\n    }).then(r => r.data),\n    smartPasteCheckDuplicate: text => api.post(\"/smart-paste/check-duplicate\", {\n      text\n    }).then(r => r.data),\n    smartPasteCreate: (text, skipLlm = false, customValues) => api.post(\"/smart-paste\", {\n      text,\n      skip_llm: skipLlm,\n      custom_values: customValues || undefined\n    }, {\n      // Phase-12 fix: this endpoint writes to Google Sheets BEFORE\n      // saving to Mongo (atomic guarantee). On a flaky cellular\n      // connection the Sheets API can take 15-25s on its own — the\n      // default 25 s axios timeout was firing right at the edge and\n      // surfacing as \"Network Error\" even when the backend was\n      // about to succeed. 60 s comfortably covers a slow round-trip.\n      timeout: 60000\n    }).then(r => r.data),\n    // Phase-C: Pull every Master-Sheet row tagged with the caller's\n    // user_id into the caller's own personal sheet. `overwrite=true`\n    // (default) clears the user's tab data rows first to reflect any\n    // admin edits. `false` appends only new rows (dedup by master_order_id\n    // / composite key for legacy rows).\n    syncFromMaster: (overwrite = true) => api.post(\"/sheets/sync-from-master\", {\n      overwrite\n    }).then(r => r.data),\n    // Phase-7e: Live preview of the next Master Order ID for the New\n    // Shipment form. Does NOT consume the counter — actual ID is allocated\n    // at save time. Frontend may pass the previewed value back via\n    // `master_order_id` in POST /shipments to lock it in.\n    peekMasterOrderId: () => api.get(\"/orders/peek-master-id\").then(r => r.data),\n    // Phase-7f: Read / write the global Master Order ID counter.\n    // Used in Settings to migrate from a legacy numbering system —\n    // eg user has shipped 2200 parcels and wants the next master ID\n    // to start from `02201`. setMasterIdCounter forces seq=2200 so the\n    // next allocation produces `<YYMMDD>02201`.\n    getMasterIdCounter: () => api.get(\"/orders/master-id-counter\").then(r => r.data),\n    setMasterIdCounter: (seq, force = false) => api.post(\"/orders/master-id-counter\", {\n      seq,\n      force\n    }).then(r => r.data),\n    // Conversational Smart Paste (chat UI).\n    smartPasteChat: (fields, reply) => api.post(\"/smart-paste/chat\", {\n      fields,\n      reply\n    }).then(r => r.data),\n    // Phase-15: City → State + Pincode candidate lookup. Powers the\n    // Smart Paste Summary Card auto-fill / \"Confirm pincode\" UX.\n    // Free India Post API behind a Mongo cache, so repeat lookups\n    // for the same city are i