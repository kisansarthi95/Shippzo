{\n      force\n    }).then(r => r.data),\n    meGenerateTemplateVariants: (template_type, tone_description, quick_chip) => api.post(\"/me/whatsapp-templates/generate-variants\", {\n      template_type,\n      tone_description,\n      quick_chip\n    }).then(r => r.data),\n    meSaveTemplateVariants: (template_type, variants) => api.post(\"/me/whatsapp-templates/save-variants\", {\n      template_type,\n      variants\n    }).then(r => r.data),\n    meGetTemplateVariants: () => api.get(\"/me/whatsapp-template-variants\").then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase-G1/G2: Stage Rules — unified SLA + alert + template config\n    // ───────────────────────────────────────────────────────────────────\n    adminGetStageRules: () => api.get(\"/admin/stage-rules\").then(r => r.data),\n    adminPutStageRules: payload => api.put(\"/admin/stage-rules\", payload).then(r => r.data),\n    meGetStageRules: () => api.get(\"/me/stage-rules\").then(r => r.data),\n    // ───────────────────────────────────────────────────────────────────\n    // Phase-G3: SLA Engine — alerts, scan trigger, summary\n    // ───────────────────────────────────────────────────────────────────\n    adminSlaRunNow: () => api.post(\"/admin/sla/run-now\").then(r => r.data),\n    adminSlaAlerts: (params = {}) => api.get(\"/admin/sla/alerts\", {\n      params\n    }).then(r => r.data),\n    adminSlaSummary: () => api.get(\"/admin/sla/summary\").then(r => r.data),\n    adminSlaDismiss: alertId => api.post(`/admin/sla/alerts/${encodeURIComponent(alertId)}/dismiss`).then(r => r.data),\n    adminSlaDismissBulk: payload => api.post(\"/admin/sla/alerts/dismiss-bulk\", payload).then(r => r.data),\n    meSlaAlerts: (params = {}) => api.get(\"/me/sla/alerts\", {\n      params\n    }).then(r => r.data),\n    // ─── Phase A: Team Members (staff contacts + permissions) ───────\n    // Backend router lives at /api/me/team-members and enforces the\n    // plan