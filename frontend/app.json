{
  "expo": {
    "name": "Shippzo",
    "slug": "shippzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shippzo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shippzo.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan addresses & barcodes from photos",
        "NSPhotoLibraryUsageDescription": "Pick a photo to extract address details",
        "NSUserTrackingUsageDescription": "Help improve Shippzo with usage analytics",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "chatgpt",
          "whatsapp",
          "tel",
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.shippzo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5A00"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan courier tracking barcodes quickly"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF5A00",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "storeListingName": "Shippzo - Courier Labels",
      "privacyPolicyUrl": "https://logistics-hub-740.preview.emergentagent.com/api/legal/privacy",
      "termsUrl": "https://logistics-hub-740.preview.emergentagent.com/api/legal/terms",
      "refundPolicyUrl": "https://logistics-hub-740.preview.emergentagent.com/api/legal/refund",
      "supportEmail": "shippzo.support@gmail.com",
      "supportPhone": "",
      "appCategory": "BUSINESS",
      "_note_about_urls": "These point to backend-hosted HTML so Play/App Store reviewers always see live policies. Once shippzo.com/privacy is published, replace with shippzo.com URLs."
    }
  }
}
